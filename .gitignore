# Whitelist: everything is ignored unless allowed below. A new top-level path needs an allow line before its first commit.
/*
!/.gitignore
!/.github/
!/hooks/
!/LICENSE
!/README.md
!/package.json
!/pnpm-workspace.yaml
!/pnpm-lock.yaml
!/tsconfig.base.json
!/scripts/
!/spec/
!/packages/
/packages/*/*
!/packages/*/src/
!/packages/*/test/
!/packages/*/package.json
!/packages/*/README.md
!/packages/*/LICENSE
!/packages/*/tsconfig*.json
!/packages/*/tsdown.config.ts
!/packages/*/server.json
!/packages/cli/install.sh
!/packages/cli/winget/
!/packages/mcp/Dockerfile
!/packages/sdk/jsr.json

# Denies last (they win over the allows above).
dist/
node_modules/
*.tgz
.env*
*.env
*.key
*keypair*
*secret*
*.local.*
.claude/
CLAUDE.md
NEXT.md
wiki/
docs/
